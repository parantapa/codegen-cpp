{#- One value appended to the builder that holds it,
    indented by the width its continuation line needs. -#}
{%- macro append_value(node, expr, indent) -%}
{%- if node.kind == "scalar" -%}
check(builder_{{ node.var }}_->Append({{ expr }}),
{{ indent }}      "failed to write '{{ node.key }}'");
{%- else -%}
append_{{ node.var }}({{ expr }});
{%- endif -%}
{%- endmacro %}

// Writes '{{ table.name }}' tables to a Parquet file,
// one batch of rows at a time.
class {{ parquet_writer.name }} {
  public:
    // The number of rows stored in a row group, unless asked otherwise.
    static constexpr std::int64_t default_row_group_length = 128000;

    // Open parquet_file for writing, replacing it if it already exists.
    explicit {{ parquet_writer.name }}(
        const std::string& parquet_file,
        arrow::Compression::type compression = arrow::Compression::ZSTD,
        int compression_level = arrow::util::kUseDefaultCompressionLevel,
        std::int64_t row_group_length = default_row_group_length)
        : parquet_file_(parquet_file) {
        if (row_group_length <= 0) [[unlikely]] {
            throw std::invalid_argument(
                "row_group_length must be larger than zero");
        }

        {# The columns are written under the names the file is to carry,
           which are the names of the columns
           unless the writer renames them. -#}
        schema_ = arrow::schema({
{%- for column in columns %}
            arrow::field({{ column.name_in_file | cpp_string }}, {{ column.arrow }}),
{%- endfor %}
        });

        output_ = unwrap(arrow::io::FileOutputStream::Open(parquet_file_),
                         "failed to open '" + parquet_file_ + "'");

        const auto properties = parquet::WriterProperties::Builder()
                                    .compression(compression)
                                    ->compression_level(compression_level)
                                    ->max_row_group_length(row_group_length)
                                    ->build();

        writer_ = unwrap(
            parquet::arrow::FileWriter::Open(*schema_, arrow::default_memory_pool(),
                                             output_, properties),
            "failed to write '" + parquet_file_ + "'");
    }

    ~{{ parquet_writer.name }}() {
        try {
            close();
        } catch (...) {
            {#- A destructor cannot report the failure of close(); #}
        }
    }

    void write_batch(const {{ table.name }}& table) {
        if (writer_ == nullptr) [[unlikely]] {
            throw std::runtime_error("'" + parquet_file_ + "' is closed");
        }
{% for column in columns %}
{%- if column.kind == "scalar" %}
        {{ column.builder_type }} builder_{{ column.member }};
        check(builder_{{ column.member }}.AppendValues(table.{{ column.member }}),
              "failed to write column '{{ column.member }}'");
        std::shared_ptr<arrow::Array> column_{{ column.member }};
        check(builder_{{ column.member }}.Finish(&column_{{ column.member }}),
              "failed to write column '{{ column.member }}'");
{% else %}
        for (const auto& value : table.{{ column.member }}) {
            append_{{ column.var }}(value);
        }
        std::shared_ptr<arrow::Array> column_{{ column.member }};
        check(builder_{{ column.var }}_->Finish(&column_{{ column.member }}),
              "failed to write column '{{ column.member }}'");
{% endif %}
{%- endfor %}
        const auto batch = arrow::RecordBatch::Make(
            schema_, static_cast<std::int64_t>(table.size()),
            {
{%- for column in columns %}
                column_{{ column.member }},
{%- endfor %}
            });

        check(writer_->WriteRecordBatch(*batch),
              "failed to write '" + parquet_file_ + "'");
    }

    void close() {
        if (writer_ != nullptr) {
            auto writer = std::move(writer_);
            writer_.reset();
            check(writer->Close(), "failed to close '" + parquet_file_ + "'");
        }

        if (output_ != nullptr) {
            auto output = std::move(output_);
            output_.reset();
            check(output->Close(), "failed to close '" + parquet_file_ + "'");
        }
    }

  private:
    {# Throw unless result holds a value, and return the value it holds. -#}
    template <typename T>
    static T unwrap(arrow::Result<T> result, const std::string& what) {
        check(result.status(), what);
        return std::move(result).ValueOrDie();
    }

    {# Throw unless status is ok. -#}
    static void check(const arrow::Status& status, const std::string& what) {
        if (!status.ok()) [[unlikely]] {
            throw std::runtime_error(what + ": " + status.ToString());
        }
    }
{% for node in builders %}
{%- if node.kind == "vector" %}
    {# Append one '{{ node.cpp }}' to the LIST that '{{ node.key }}' is stored as. -#}
    void append_{{ node.var }}(const {{ node.cpp }}& value) {
        check(builder_{{ node.var }}_->Append(),
              "failed to write '{{ node.key }}'");
        for (const auto& element : value) {
            {{ append_value(node.element, "element", " " * 12) }}
        }
    }
{% elif node.kind == "map" %}
    {# Append one '{{ node.cpp }}' to the MAP that '{{ node.key }}' is stored as. -#}
    void append_{{ node.var }}(const {{ node.cpp }}& value) {
        check(builder_{{ node.var }}_->Append(),
              "failed to write '{{ node.key }}'");
        for (const auto& [key, item] : value) {
            {{ append_value(node.key_node, "key", " " * 12) }}
            {{ append_value(node.value, "item", " " * 12) }}
        }
    }
{% elif node.kind == "struct" %}
    {# Append one '{{ node.cpp }}' to the group that '{{ node.key }}' is stored as. -#}
    void append_{{ node.var }}(const {{ node.cpp }}& value) {
        check(builder_{{ node.var }}_->Append(),
              "failed to write '{{ node.key }}'");
{%- for field in node.fields %}
        {{ append_value(field, "value." ~ field.member, " " * 8) }}
{%- endfor %}
    }
{% endif %}
{%- endfor %}
    std::string parquet_file_;
    std::shared_ptr<arrow::Schema> schema_;

    {# The stream has to outlive the writer using it,
       so it is declared first and destroyed last. -#}
    std::shared_ptr<arrow::io::OutputStream> output_;
    std::unique_ptr<parquet::arrow::FileWriter> writer_;
{%- if builders %}

    {# The builders of the columns that hold an aggregate type.
       Each of them is handed the builders of the parts below it,
       so they are declared from the deepest part up. -#}
{%- for node in builders %}
{%- if node.kind == "scalar" %}
    std::shared_ptr<{{ node.builder_type }}> builder_{{ node.var }}_ =
        std::make_shared<{{ node.builder_type }}>(arrow::default_memory_pool());
{%- elif node.kind == "vector" %}
    std::shared_ptr<arrow::ListBuilder> builder_{{ node.var }}_ =
        std::make_shared<arrow::ListBuilder>(arrow::default_memory_pool(),
                                             builder_{{ node.element.var }}_,
                                             {{ node.arrow }});
{%- elif node.kind == "map" %}
    std::shared_ptr<arrow::MapBuilder> builder_{{ node.var }}_ =
        std::make_shared<arrow::MapBuilder>(arrow::default_memory_pool(),
                                            builder_{{ node.key_node.var }}_,
                                            builder_{{ node.value.var }}_,
                                            {{ node.arrow }});
{%- elif node.kind == "struct" %}
    std::shared_ptr<arrow::StructBuilder> builder_{{ node.var }}_ =
        std::make_shared<arrow::StructBuilder>(
            {{ node.arrow }}, arrow::default_memory_pool(),
            std::vector<std::shared_ptr<arrow::ArrayBuilder>>{
{%- for field in node.fields %}
                builder_{{ field.var }}_{% if not loop.last %},{% endif %}
{%- endfor %}
            });
{%- endif %}
{%- endfor %}
{%- endif %}
};
