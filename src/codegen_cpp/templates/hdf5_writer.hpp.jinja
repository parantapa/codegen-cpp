// of the dataset '{{ dataset.name }}'
// into a group of an HDF5 file.
class {{ hdf5_writer.name }} {
  public:
    // Open the group group_path of the open HDF5 file file for writing,
    // creating it and any group above it that is missing.
    // The file has to be open for writing;
    // a read-only file is reported like any other failure.
    {{ hdf5_writer.name }}(H5::H5File& file, const std::string& group_path)
        : group_path_(group_path) {
        try {
            {# Walk the path one name at a time,
               so that a group that is missing is created
               instead of looked for below a group that is missing too. -#}
            group_ = file.openGroup("/");
            for (std::size_t begin = 0; begin <= group_path_.size();) {
                const std::size_t end = group_path_.find('/', begin);
                const std::string name = group_path_.substr(
                    begin, end == std::string::npos ? end : end - begin);
                if (!name.empty()) {
                    group_ = group_.nameExists(name) ? group_.openGroup(name)
                                                     : group_.createGroup(name);
                }
                if (end == std::string::npos) {
                    break;
                }
                begin = end + 1;
            }
        } catch (const H5::Exception& e) {
            throw std::runtime_error("failed to write '" + group_path_ + "': " +
                                     e.getDetailMsg());
        }
    }

    // Write every array of data into the group.
    // An array the group already holds under the same name is replaced,
    // whatever shape and datatype it was stored with.
    void write_dataset(const {{ dataset.name }}& data) {
        {# Every array of the dataset has the shape that data was
           allocated with. -#}
        std::array<hsize_t, {{ dataset.name }}::rank> extents;
        for (std::size_t i = 0; i < {{ dataset.name }}::rank; ++i) {
            extents[i] = static_cast<hsize_t>(data.dims[i]);
        }

        try {
            create_arrays(extents);
{%- for array in arrays -%}
{{ write_array(array) }}
{%- endfor %}
        } catch (const H5::Exception& e) {
            throw std::runtime_error("failed to write '" + group_path_ + "': " +
                                     e.getDetailMsg());
        }
    }

    // Create every array of the dataset with the shape shape,
    // which is one extent per dim of the dataset, and write nothing into them.
    // An array that is larger than memory is laid out here
    // and filled in piece by piece with write_partial_dataset,
    // where write_dataset asks for the whole of it at once.
    // An array the group already holds under the same name is replaced,
    // whatever shape and datatype it was stored with.
    void create_dataset(std::span<const std::size_t> shape) {
        if (shape.size() != {{ dataset.name }}::rank) [[unlikely]] {
            throw std::invalid_argument(
                "shape must hold one extent per dim of '{{ dataset.name }}'");
        }

        std::array<hsize_t, {{ dataset.name }}::rank> extents;
        for (std::size_t i = 0; i < {{ dataset.name }}::rank; ++i) {
            extents[i] = static_cast<hsize_t>(shape[i]);
        }

        try {
            create_arrays(extents);
        } catch (const H5::Exception& e) {
            throw std::runtime_error("failed to write '" + group_path_ + "': " +
                                     e.getDetailMsg());
        }
    }

    // Write data into the part of every array that begins at offset,
    // which is one index per dim of the dataset.
    // The shape data was allocated with is how much is written,
    // so the group has to hold every array already,
    // with room for that much of it beyond offset;
    // write_dataset and create_dataset are what create them.
    void write_partial_dataset(const {{ dataset.name }}& data,
                               std::span<const std::size_t> offset) {
        if (offset.size() != {{ dataset.name }}::rank) [[unlikely]] {
            throw std::invalid_argument(
                "offset must hold one index per dim of '{{ dataset.name }}'");
        }

        try {
            {# The hyperslab starts at offset and is as large as data,
               which is also the whole of the memory it is written from. -#}
            std::array<hsize_t, {{ dataset.name }}::rank> start;
            std::array<hsize_t, {{ dataset.name }}::rank> count;
            for (std::size_t i = 0; i < {{ dataset.name }}::rank; ++i) {
                start[i] = static_cast<hsize_t>(offset[i]);
                count[i] = static_cast<hsize_t>(data.dims[i]);
            }
            const H5::DataSpace memory(static_cast<int>({{ dataset.name }}::rank),
                                       count.data());
{%- for array in arrays -%}
{{ write_part_array(array) }}
{%- endfor %}
        } catch (const H5::Exception& e) {
            throw std::runtime_error("failed to write '" + group_path_ + "': " +
                                     e.getDetailMsg());
        }
    }

  private:{{ create_arrays() }}
{% for array in arrays %}{{ open_array(array) }}
{% endfor %}
    std::string group_path_;
    H5::Group group_;
};
