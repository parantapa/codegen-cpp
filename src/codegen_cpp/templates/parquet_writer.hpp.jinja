// Writes '{{ table.name }}' tables to a Parquet file,
// one batch of rows at a time.
class {{ parquet_writer.name }} {
  public:
    // The number of rows stored in a row group, unless asked otherwise.
    static constexpr std::int64_t default_row_group_length = 128000;

    // Open parquet_file for writing, replacing it if it already exists.
    explicit {{ parquet_writer.name }}(
        const std::string& parquet_file,
        arrow::Compression::type compression = arrow::Compression::ZSTD,
        int compression_level = arrow::util::kUseDefaultCompressionLevel,
        std::int64_t row_group_length = default_row_group_length)
        : parquet_file_(parquet_file) {
        if (row_group_length <= 0) [[unlikely]] {
            throw std::invalid_argument(
                "row_group_length must be larger than zero");
        }

        schema_ = arrow::schema({
{%- for column in table.columns %}
            arrow::field("{{ column.name }}", {{ column.type | arrow_type }}),
{%- endfor %}
        });

        output_ = unwrap(arrow::io::FileOutputStream::Open(parquet_file_),
                         "failed to open '" + parquet_file_ + "'");

        const auto properties = parquet::WriterProperties::Builder()
                                    .compression(compression)
                                    ->compression_level(compression_level)
                                    ->max_row_group_length(row_group_length)
                                    ->build();

        writer_ = unwrap(
            parquet::arrow::FileWriter::Open(*schema_, arrow::default_memory_pool(),
                                             output_, properties),
            "failed to write '" + parquet_file_ + "'");
    }

    ~{{ parquet_writer.name }}() {
        try {
            close();
        } catch (...) {
            {#- A destructor cannot report the failure of close(); #}
        }
    }

    void write_batch(const {{ table.name }}& table) {
        if (writer_ == nullptr) [[unlikely]] {
            throw std::runtime_error("'" + parquet_file_ + "' is closed");
        }
{% for column in table.columns %}
        {{ column.type | arrow_builder_type }} builder_{{ column.name }};
        check(builder_{{ column.name }}.AppendValues(table.{{ column.name }}),
              "failed to write column '{{ column.name }}'");
        std::shared_ptr<arrow::Array> column_{{ column.name }};
        check(builder_{{ column.name }}.Finish(&column_{{ column.name }}),
              "failed to write column '{{ column.name }}'");
{% endfor %}
        const auto batch = arrow::RecordBatch::Make(
            schema_, static_cast<std::int64_t>(table.size()),
            {
{%- for column in table.columns %}
                column_{{ column.name }},
{%- endfor %}
            });

        check(writer_->WriteRecordBatch(*batch),
              "failed to write '" + parquet_file_ + "'");
    }

    void close() {
        if (writer_ != nullptr) {
            auto writer = std::move(writer_);
            writer_.reset();
            check(writer->Close(), "failed to close '" + parquet_file_ + "'");
        }

        if (output_ != nullptr) {
            auto output = std::move(output_);
            output_.reset();
            check(output->Close(), "failed to close '" + parquet_file_ + "'");
        }
    }

  private:
    {# Throw unless result holds a value, and return the value it holds. -#}
    template <typename T>
    static T unwrap(arrow::Result<T> result, const std::string& what) {
        check(result.status(), what);
        return std::move(result).ValueOrDie();
    }

    {# Throw unless status is ok. -#}
    static void check(const arrow::Status& status, const std::string& what) {
        if (!status.ok()) [[unlikely]] {
            throw std::runtime_error(what + ": " + status.ToString());
        }
    }

    std::string parquet_file_;
    std::shared_ptr<arrow::Schema> schema_;

    {# The stream has to outlive the writer using it,
       so it is declared first and destroyed last. -#}
    std::shared_ptr<arrow::io::OutputStream> output_;
    std::unique_ptr<parquet::arrow::FileWriter> writer_;
};
