// of the dataset '{{ dataset.name }}'
// into the group group_path of the open HDF5 file file, out of data.
inline void {{ hdf5_writer.name }}(H5::H5File& file, const std::string& group_path,
{{ " " * (hdf5_writer.name | length + 13) }}const {{ dataset.name }}& data) {
    try {
        // Walk the path one name at a time, so that a group that is missing
        // is created instead of looked for below a group that is missing too.
        H5::Group group = file.openGroup("/");
        for (std::size_t begin = 0; begin <= group_path.size();) {
            const std::size_t end = group_path.find('/', begin);
            const std::string name = group_path.substr(
                begin, end == std::string::npos ? end : end - begin);
            if (!name.empty()) {
                group = group.nameExists(name) ? group.openGroup(name)
                                               : group.createGroup(name);
            }
            if (end == std::string::npos) {
                break;
            }
            begin = end + 1;
        }

        // Every array of '{{ dataset.name }}' has the shape that data was
        // allocated with, so one dataspace describes all of them.
        std::array<hsize_t, {{ dataset.name }}::rank> extents;
        for (std::size_t i = 0; i < {{ dataset.name }}::rank; ++i) {
            extents[i] = static_cast<hsize_t>(data.dims[i]);
        }
        const H5::DataSpace space(static_cast<int>({{ dataset.name }}::rank),
                                  extents.data());
{%- for array in arrays %}
{{ write_array(array) }}
{%- endfor %}
    } catch (const H5::Exception& e) {
        throw std::runtime_error("failed to write '" + group_path + "': " +
                                 e.getDetailMsg());
    }
}
