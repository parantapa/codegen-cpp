{%- macro read_into(nd_array) %}
{%- set cpp = nd_array.type | cpp_type %}
{%- set native = nd_array.type | hdf5_native_type %}
{%- if direct %}
                {# The dataset stores its arrays the way HDF5 reads them,
                   so the elements land where they belong. -#}
                array.read(data._mem_{{ nd_array.name }}.get(),
                           {{ native }});
{%- else %}
                {# HDF5 reads the elements in row major order,
                   but the dataset stores them in column major order,
                   so they are put in place one at a time. -#}
                std::vector<{{ cpp }}> buffer(data.size());
                array.read(buffer.data(), {{ native }});
{{ scatter_buffer(nd_array) }}
{%- endif %}
{%- endmacro %}
{%- macro read_part_into(nd_array) %}
{%- set cpp = nd_array.type | cpp_type %}
{%- set native = nd_array.type | hdf5_native_type %}
{%- if direct %}
                {# The part of the file that the hyperslab selects
                   fills the whole of data, which memory describes. -#}
                array.read(data._mem_{{ nd_array.name }}.get(),
                           {{ native }}, memory, space);
{%- else %}
                {# HDF5 reads the elements in row major order,
                   but the dataset stores them in column major order,
                   so they are put in place one at a time. -#}
                std::vector<{{ cpp }}> buffer(data.size());
                array.read(buffer.data(), {{ native }},
                           memory, space);
{{ scatter_buffer(nd_array) }}
{%- endif %}
{%- endmacro %}
