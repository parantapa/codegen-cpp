// Writes '{{ table.name }}' tables to a CSV file, one batch of rows at a time.
class {{ csv_writer.name }} {
  public:
    // Open csv_file for writing, replacing it if it already exists.
    // The compression of the file is guessed from its name unless it is given,
    // and compression_level tunes the codec.
    explicit {{ csv_writer.name }}(
        const std::string& csv_file,
        std::optional<arrow::Compression::type> compression = std::nullopt,
        int compression_level = arrow::util::kUseDefaultCompressionLevel)
        : csv_file_(csv_file) {
        {# The columns are written under the names the file is to carry,
           which are the names of the columns
           unless the writer renames them. -#}
        schema_ = arrow::schema({
{%- for column in columns %}
            arrow::field({{ column.name_in_file | cpp_string }}, {{ column.arrow }}),
{%- endfor %}
        });

        output_ = unwrap(arrow::io::FileOutputStream::Open(csv_file_),
                         "failed to open '" + csv_file_ + "'");

        const auto codec_type = compression.value_or(compression_of(csv_file_));
        if (codec_type != arrow::Compression::UNCOMPRESSED) {
            codec_ = unwrap(
                arrow::util::Codec::Create(
                    codec_type, arrow::util::CodecOptions(compression_level)),
                "failed to compress '" + csv_file_ + "'");

            {# Closing this stream closes the file it writes to. -#}
            output_ = unwrap(
                arrow::io::CompressedOutputStream::Make(codec_.get(), output_),
                "failed to compress '" + csv_file_ + "'");
        }
        writer_ = unwrap(arrow::csv::MakeCSVWriter(output_, schema_),
                         "failed to write '" + csv_file_ + "'");
    }

    ~{{ csv_writer.name }}() {
        try {
            close();
        } catch (...) {
            {#- A destructor cannot report the failure of close(); #}
        }
    }

    void write_batch(const {{ table.name }}& table) {
        if (writer_ == nullptr) [[unlikely]] {
            throw std::runtime_error("'" + csv_file_ + "' is closed");
        }
{% for column in columns %}
        {{ column.builder_type }} builder_{{ column.member }};
        check(builder_{{ column.member }}.AppendValues(table.{{ column.member }}),
              "failed to write column '{{ column.member }}'");
        std::shared_ptr<arrow::Array> column_{{ column.member }};
        check(builder_{{ column.member }}.Finish(&column_{{ column.member }}),
              "failed to write column '{{ column.member }}'");
{% endfor %}
        const auto batch = arrow::RecordBatch::Make(
            schema_, static_cast<std::int64_t>(table.size()),
            {
{%- for column in columns %}
                column_{{ column.member }},
{%- endfor %}
            });

        check(writer_->WriteRecordBatch(*batch),
              "failed to write '" + csv_file_ + "'");
        check(output_->Flush(), "failed to write '" + csv_file_ + "'");
    }

    void close() {
        if (writer_ != nullptr) {
            auto writer = std::move(writer_);
            writer_.reset();
            check(writer->Close(), "failed to close '" + csv_file_ + "'");
        }

        if (output_ != nullptr) {
            auto output = std::move(output_);
            output_.reset();
            check(output->Close(), "failed to close '" + csv_file_ + "'");
        }
    }

  private:
    {# Return the codec that a file of this name is compressed with. -#}
    static arrow::Compression::type compression_of(const std::string& path) {
        if (path.ends_with(".gz")) {
            return arrow::Compression::GZIP;
        }
        if (path.ends_with(".zst")) {
            return arrow::Compression::ZSTD;
        }
        if (path.ends_with(".bz2")) {
            return arrow::Compression::BZ2;
        }
        if (path.ends_with(".lz4")) {
            return arrow::Compression::LZ4_FRAME;
        }
        return arrow::Compression::UNCOMPRESSED;
    }

    {# Throw unless result holds a value, and return the value it holds. -#}
    template <typename T>
    static T unwrap(arrow::Result<T> result, const std::string& what) {
        check(result.status(), what);
        return std::move(result).ValueOrDie();
    }

    {# Throw unless status is ok. -#}
    static void check(const arrow::Status& status, const std::string& what) {
        if (!status.ok()) [[unlikely]] {
            throw std::runtime_error(what + ": " + status.ToString());
        }
    }

    std::string csv_file_;
    std::shared_ptr<arrow::Schema> schema_;

    {# The codec has to outlive the stream compressing with it,
       so it is declared first and destroyed last. -#}
    std::unique_ptr<arrow::util::Codec> codec_;

    {# The stream has to outlive the writer using it,
       so it is declared first and destroyed last. -#}
    std::shared_ptr<arrow::io::OutputStream> output_;
    std::shared_ptr<arrow::ipc::RecordBatchWriter> writer_;
};
