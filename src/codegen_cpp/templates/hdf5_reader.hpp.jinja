class {{ hdf5_reader.name }} {
  public:
    // Open the group group_path of the open HDF5 file file,
    // and look every array up in it once.
    // Each of them has to be there,
    // and to be stored with the datatype that the dataset declares for it.
    // The arrays are looked up again by every read,
    // so a group written again after the reader was constructed
    // is read back as it stands rather than as it was.
    {{ hdf5_reader.name }}(H5::H5File& file, const std::string& group_path)
        : group_path_(group_path) {
        try {
            group_ = file.openGroup(group_path_);
{%- for array in arrays %}
            open_{{ array.name }}();
{%- endfor %}
        } catch (const H5::Exception& e) {
            throw std::runtime_error("failed to read '" + group_path_ + "': " +
                                     e.getDetailMsg());
        }
    }

    {{ hdf5_reader.name }}(const {{ hdf5_reader.name }}&) = delete;
    {{ hdf5_reader.name }}& operator=(const {{ hdf5_reader.name }}&) = delete;

    // Read every array into data, which says by the shape it was allocated
    // with what shape the file has to hold them in.
    void read_dataset({{ dataset.name }}& data) const {
        try {
{%- for array in arrays -%}
{{ read_array(array) }}
{%- endfor %}
        } catch (const H5::Exception& e) {
            throw std::runtime_error("failed to read '" + group_path_ + "': " +
                                     e.getDetailMsg());
        }
    }

    // Read the part of every array that begins at offset into data,
    // which is one index per dim of the dataset.
    // The shape data was allocated with is how much is read,
    // so the file has to hold that much of every array beyond offset.
    void read_partial_dataset({{ dataset.name }}& data,
                              std::span<const std::size_t> offset) const {
        if (offset.size() != {{ dataset.name }}::rank) [[unlikely]] {
            throw std::invalid_argument(
                "offset must hold one index per dim of '{{ dataset.name }}'");
        }

        try {
            {# The hyperslab starts at offset and is as large as data,
               which is also the whole of the memory it is read into. -#}
            std::array<hsize_t, {{ dataset.name }}::rank> start;
            std::array<hsize_t, {{ dataset.name }}::rank> count;
            for (std::size_t i = 0; i < {{ dataset.name }}::rank; ++i) {
                start[i] = static_cast<hsize_t>(offset[i]);
                count[i] = static_cast<hsize_t>(data.dims[i]);
            }
            const H5::DataSpace memory(static_cast<int>({{ dataset.name }}::rank),
                                       count.data());
{%- for array in arrays -%}
{{ read_part_array(array) }}
{%- endfor %}
        } catch (const H5::Exception& e) {
            throw std::runtime_error("failed to read '" + group_path_ + "': " +
                                     e.getDetailMsg());
        }
    }

  private:{% for array in arrays %}{{ open_array(array) }}
{% endfor %}
    std::string group_path_;
    H5::Group group_;
};
