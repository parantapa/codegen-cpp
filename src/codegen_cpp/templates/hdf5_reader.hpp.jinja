{%- set arrays = dataset | selected_arrays(hdf5_reader) -%}
{%- set direct = not dataset.column_major or dataset.ndim == 1 -%}
{%- macro open_array(nd_array) %}
    // Open the array {{ nd_array.name }} of the group,
    // which has to be there
    // and to be stored with the datatype that the dataset declares for it.
    H5::DataSet open_{{ nd_array.name }}() const {
        const std::string path = group_path_ + "/{{ nd_array.name }}";
        if (!group_.nameExists("{{ nd_array.name }}")) [[unlikely]] {
            throw std::runtime_error("'" + path + "' is not in the HDF5 file");
        }

        const H5::DataSet array = group_.openDataSet("{{ nd_array.name }}");

        {# An array stored through a filter that hdf5 loads at run time
           cannot be read back without it. -#}
        if (!array.getCreatePlist().allFiltersAvail()) [[unlikely]] {
            throw std::runtime_error(
                "'" + path + "' is stored with a filter that is not "
                "available; hdf5 loads a filter from the directories "
                "in HDF5_PLUGIN_PATH");
        }

        const H5::DataType stored = array.getDataType();
        if (stored != {{ nd_array.type | hdf5_native_type }}) [[unlikely]] {
            throw std::runtime_error(
                "'" + path + "' is not stored as '{{ nd_array.type.value }}'");
        }

        return array;
    }
{%- endmacro %}
{%- macro check_shape() %}
                const H5::DataSpace space = array.getSpace();
                if (space.getSimpleExtentNdims() != {{ dataset.ndim }}) [[unlikely]] {
                    throw std::runtime_error("'" + path +
                                             "' does not have rank {{ dataset.ndim }}");
                }

                std::array<hsize_t, {{ dataset.name }}::rank> extents;
                space.getSimpleExtentDims(extents.data());
                for (std::size_t i = 0; i < {{ dataset.name }}::rank; ++i) {
                    const hsize_t declared = static_cast<hsize_t>(data.dims[i]);
                    if (extents[i] != declared) [[unlikely]] {
                        throw std::runtime_error(
                            "'" + path + "' has extent " +
                            std::to_string(extents[i]) + " instead of " +
                            std::to_string(data.dims[i]) + " along dimension " +
                            std::to_string(i));
                    }
                }
{%- endmacro %}
{%- macro check_room() %}
                H5::DataSpace space = array.getSpace();
                if (space.getSimpleExtentNdims() != {{ dataset.ndim }}) [[unlikely]] {
                    throw std::runtime_error("'" + path +
                                             "' does not have rank {{ dataset.ndim }}");
                }

                std::array<hsize_t, {{ dataset.name }}::rank> extents;
                space.getSimpleExtentDims(extents.data());
                for (std::size_t i = 0; i < {{ dataset.name }}::rank; ++i) {
                    if (extents[i] < start[i] + count[i]) [[unlikely]] {
                        throw std::runtime_error(
                            "'" + path + "' has extent " +
                            std::to_string(extents[i]) + ", which does not hold " +
                            std::to_string(count[i]) + " elements at offset " +
                            std::to_string(start[i]) + " along dimension " +
                            std::to_string(i));
                    }
                }

                space.selectHyperslab(H5S_SELECT_SET, count.data(), start.data());
