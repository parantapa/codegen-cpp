{%- macro create_arrays() %}
    // Create every array of the dataset with the shape extents,
    // replacing whatever the group holds under the same name already.
    void create_arrays(
        const std::array<hsize_t, {{ dataset.name }}::rank>& extents) {
        {# Every array of the dataset has the same shape,
           so one dataspace describes all of them. -#}
        const H5::DataSpace space(static_cast<int>({{ dataset.name }}::rank),
                                  extents.data());
{%- if chunked %}

        {# Every array is stored in chunks of the declared shape,
           which is what a filter of the pipeline below applies to. -#}
        H5::DSetCreatPropList plist;
        std::array<hsize_t, {{ dataset.name }}::rank> chunk = {
{%- for extent in hdf5_writer.chunk %}{{ extent }}{{ ", " if not loop.last }}{% endfor %}};
        for (std::size_t i = 0; i < {{ dataset.name }}::rank; ++i) {
            {# A chunk may not reach past the extent it is stored along,
               and an extent of zero still takes a chunk of one. -#}
            if (chunk[i] > extents[i]) {
                chunk[i] = extents[i];
            }
            if (chunk[i] < 1) {
                chunk[i] = 1;
            }
        }
        plist.setChunk(static_cast<int>({{ dataset.name }}::rank), chunk.data());
{%- for line in filters %}
        {{ line }}
{%- endfor %}
{%- if hdf5_writer.compression.value != "none" %}

        {# A filter has to be there before anything is written through it. -#}
        if (!plist.allFiltersAvail()) [[unlikely]] {
            throw std::runtime_error(
                "the '{{ hdf5_writer.compression.value }}' filter is not available; "
{%- if loaded_filter %}
                "hdf5 loads a filter from the directories "
                "in HDF5_PLUGIN_PATH");
{%- else %}
                "hdf5 was built without it");
{%- endif %}
        }
{%- endif %}
{%- endif %}
{%- for nd_array in arrays %}

        if (group_.nameExists("{{ nd_array.name }}")) {
            group_.unlink("{{ nd_array.name }}");
        }
        group_.createDataSet("{{ nd_array.name }}", {{ nd_array.type | hdf5_native_type }},
                             space{{ ", plist" if chunked }});
{%- endfor %}
    }
{%- endmacro %}
{%- macro open_array(nd_array) %}
    // Open the array {{ nd_array.name }} of the group,
    // which has to be there
    // and to be stored with the datatype that the dataset declares for it.
    H5::DataSet open_{{ nd_array.name }}() const {
        const std::string path = group_path_ + "/{{ nd_array.name }}";
        if (!group_.nameExists("{{ nd_array.name }}")) [[unlikely]] {
            throw std::runtime_error("'" + path + "' is not in the HDF5 file");
        }

        const H5::DataSet array = group_.openDataSet("{{ nd_array.name }}");

        {# What goes into an array stored through a filter
           that hdf5 loads at run time goes through the filter too. -#}
        if (!array.getCreatePlist().allFiltersAvail()) [[unlikely]] {
            throw std::runtime_error(
                "'" + path + "' is stored with a filter that is not "
                "available; hdf5 loads a filter from the directories "
                "in HDF5_PLUGIN_PATH");
        }

        const H5::DataType stored = array.getDataType();
        if (stored != {{ nd_array.type | hdf5_native_type }}) [[unlikely]] {
            throw std::runtime_error(
                "'" + path + "' is not stored as '{{ nd_array.type.value }}'");
        }

        return array;
    }
{%- endmacro %}
