{%- set required = columns | selectattr("default", "none") | list %}
{#- The value of one column of a table,
    read out of the array that holds it at index. -#}
{%- macro column_value(column, array, index) -%}
{%- if column.is_string -%}
{%- set read = array ~ "->GetString(" ~ index ~ ")" -%}
{%- else -%}
{%- set read = array ~ "->Value(" ~ index ~ ")" -%}
{%- endif -%}
{%- if column.default is none -%}
{{ read }}
{%- else -%}
{{ array }}->IsNull({{ index }}) ? {{ column.default }} : {{ read }}
{%- endif -%}
{%- endmacro %}

// Reads the rows of a CSV file into '{{ table.name }}' tables,
// one batch of rows at a time.
class {{ csv_reader.name }} {
  public:
    // The number of bytes read at a time, unless asked otherwise.
    static constexpr std::int32_t default_block_size = 128 * 1024 * 1024;

    // Open csv_file and prepare to read it in batches of batch_size rows.
    // The compression of the file is guessed from its name unless it is given.
    {{ csv_reader.name }}(const std::string& csv_file, std::size_t batch_size,
{{ " " * (csv_reader.name | length + 5) }}bool use_threads = false,
{{ " " * (csv_reader.name | length + 5) }}std::int32_t block_size = default_block_size,
{{ " " * (csv_reader.name | length + 5) }}std::optional<arrow::Compression::type> compression =
{{ " " * (csv_reader.name | length + 5) }}    std::nullopt)
        : csv_file_(csv_file), batch_size_(batch_size) {
        if (batch_size_ == 0) [[unlikely]] {
            throw std::invalid_argument("batch_size must be larger than zero");
        }
        if (block_size <= 0) [[unlikely]] {
            throw std::invalid_argument("block_size must be larger than zero");
        }

        std::shared_ptr<arrow::io::InputStream> input =
            unwrap(arrow::io::ReadableFile::Open(csv_file_),
                   "failed to open '" + csv_file_ + "'");

        const auto codec_type = compression.value_or(compression_of(csv_file_));
        if (codec_type != arrow::Compression::UNCOMPRESSED) {
            codec_ = unwrap(arrow::util::Codec::Create(codec_type),
                            "failed to decompress '" + csv_file_ + "'");
            input = unwrap(
                arrow::io::CompressedInputStream::Make(codec_.get(), input),
                "failed to decompress '" + csv_file_ + "'");
        }

        auto read_options = arrow::csv::ReadOptions::Defaults();
        read_options.use_threads = use_threads;
        read_options.block_size = block_size;
        auto parse_options = arrow::csv::ParseOptions::Defaults();
        auto convert_options = arrow::csv::ConvertOptions::Defaults();

        {# Read only the columns of the table, in the order
           in which they are declared, and with their declared types.
           A column is named the way the file names it,
           which is the name of the column unless the reader renames it. -#}
        convert_options.include_columns = {
{%- for column in columns %}
            {{ column.name_in_file | cpp_string }},
{%- endfor %}
        };
        convert_options.column_types = {
{%- for column in columns %}
            {{ "{" }}{{ column.name_in_file | cpp_string }}, {{ column.arrow }}},
{%- endfor %}
        };

        reader_ = unwrap(
            arrow::csv::StreamingReader::Make(arrow::io::default_io_context(),
                                              std::move(input), read_options,
                                              parse_options, convert_options),
            "failed to read '" + csv_file_ + "'");
    }

    {{ csv_reader.name }}(const {{ csv_reader.name }}&) = delete;
    {{ csv_reader.name }}& operator=(const {{ csv_reader.name }}&) = delete;

    // Return true if read_batch would append at least one row.
    bool has_more_batches() {
        fill_batch();
        return batch_ != nullptr;
    }

    // Append the next batch_size rows of the CSV file to table,
    // or fewer if the file has fewer rows left.
    void read_batch({{ table.name }}& table) {
        const std::int64_t wanted = static_cast<std::int64_t>(batch_size_);
        table.reserve(table.size() + batch_size_);

        std::int64_t appended = 0;
        while (appended < wanted) {
            fill_batch();
            if (batch_ == nullptr) {
                break;
            }
            appended += append_rows(table, wanted - appended);
        }
    }

    // Append every row of the CSV file that has not been read yet to table.
    void read_all({{ table.name }}& table) {
        table.reserve(table.size() + batch_size_);

        while (true) {
            fill_batch();
            if (batch_ == nullptr) {
                break;
            }
            append_rows(table, batch_->num_rows() - offset_);
        }
    }

  private:
    {# Return the codec that a file of this name is compressed with. -#}
    static arrow::Compression::type compression_of(const std::string& path) {
        if (path.ends_with(".gz")) {
            return arrow::Compression::GZIP;
        }
        if (path.ends_with(".zst")) {
            return arrow::Compression::ZSTD;
        }
        if (path.ends_with(".bz2")) {
            return arrow::Compression::BZ2;
        }
        if (path.ends_with(".lz4")) {
            return arrow::Compression::LZ4_FRAME;
        }
        return arrow::Compression::UNCOMPRESSED;
    }

    {# Throw unless result holds a value, and return the value it holds. -#}
    template <typename T>
    static T unwrap(arrow::Result<T> result, const std::string& what) {
        check(result.status(), what);
        return std::move(result).ValueOrDie();
    }

    {# Throw unless status is ok. -#}
    static void check(const arrow::Status& status, const std::string& what) {
        if (!status.ok()) [[unlikely]] {
            throw std::runtime_error(what + ": " + status.ToString());
        }
    }

    {# Make batch_ point at a batch with at least one unread row,
       or at nullptr once the CSV file has been read completely. -#}
    void fill_batch() {
        while (batch_ == nullptr || offset_ >= batch_->num_rows()) {
            if (done_) {
                batch_ = nullptr;
                return;
            }

            std::shared_ptr<arrow::RecordBatch> batch;
            check(reader_->ReadNext(&batch),
                  "failed to read '" + csv_file_ + "'");

            if (batch == nullptr) {
                done_ = true;
                batch_ = nullptr;
                return;
            }

            check_nulls(*batch);
            batch_ = std::move(batch);
            offset_ = 0;
        }
    }

    {# Append the first wanted rows that the batch being read still holds
       to table, and return how many rows that was. -#}
    std::int64_t append_rows({{ table.name }}& table, std::int64_t wanted) {
        const std::int64_t available = batch_->num_rows() - offset_;
        const std::int64_t rows = std::min(available, wanted);
{%- for column in columns %}
        const auto* column_{{ column.member }} =
            static_cast<const {{ column.array_type }}*>(
                batch_->column({{ loop.index0 }}).get());
{%- endfor %}

        for (std::int64_t i = offset_; i < offset_ + rows; ++i) {
            table.push_back(
{%- for column in columns %}
                {{ column_value(column, "column_" ~ column.member, "i") }}{% if not loop.last %},{% endif %}
{%- endfor %});
        }

        offset_ += rows;
        return rows;
    }

    {# Throw if a column that is not nullable contains a null value. -#}
    static void check_nulls(
{%- if required %}const arrow::RecordBatch& batch) {
{%- for column in columns %}
{%- if column.default is none %}
        if (batch.column({{ loop.index0 }})->null_count() != 0) [[unlikely]] {
            throw std::runtime_error(
                "column '{{ column.member }}' contains null values");
        }
{%- endif %}
{%- endfor %}
{%- else %}[[maybe_unused]] const arrow::RecordBatch& batch) {
{%- endif %}
    }

    std::string csv_file_;
    std::size_t batch_size_;

    {# The codec has to outlive the stream decompressing with it,
       so it is declared first and destroyed last. -#}
    std::unique_ptr<arrow::util::Codec> codec_;
    std::shared_ptr<arrow::csv::StreamingReader> reader_;

    {# The batch being read, and the index of its first unread row. -#}
    std::shared_ptr<arrow::RecordBatch> batch_;
    std::int64_t offset_ = 0;

    {# Set once the streaming reader has returned its last batch. -#}
    bool done_ = false;
};
